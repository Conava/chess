<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.lang.String?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.conava.chess.application.controllers.WaitingForMatchController"
      alignment="CENTER" spacing="0">

    <VBox alignment="CENTER" spacing="24" maxWidth="420">
        <VBox.margin><Insets top="60" right="0" bottom="0" left="0"/></VBox.margin>
        <padding><Insets top="48" right="48" bottom="48" left="48"/></padding>
        <styleClass><String fx:value="overlay-card"/></styleClass>

        <Label fx:id="searchingLabel" text="%matchmaking.searching" styleClass="dialog-title" wrapText="true"/>

        <ProgressIndicator fx:id="spinner" prefWidth="64" prefHeight="64"/>

        <Label fx:id="rulesetLabel" style="-fx-font-size:14px;" wrapText="true"/>

        <Button fx:id="cancelBtn" text="%matchmaking.cancel" onAction="#onCancel"
                styleClass="nav-button nav-button-exit" maxWidth="Infinity"/>
    </VBox>
</VBox>
