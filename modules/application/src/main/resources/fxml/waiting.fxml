<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.conava.chess.application.controllers.WaitingController"
      styleClass="overlay-card" spacing="16" alignment="CENTER" minWidth="380">
    <padding><Insets top="36" right="48" bottom="36" left="48"/></padding>
    <Label text="%waiting.title" styleClass="dialog-title"/>
    <Label text="%waiting.code" styleClass="section-heading"/>
    <TextField fx:id="codeField" editable="false" alignment="CENTER"
               style="-fx-font-size:28px; -fx-font-weight:bold; -fx-background-color:transparent; -fx-border-color:transparent;"/>
    <Button fx:id="copyBtn" text="%game.joinCode.copy" onAction="#onCopy" styleClass="btn-primary"/>
    <Label text="%waiting.instruction" wrapText="true" alignment="CENTER"/>
    <Button text="%waiting.cancel" onAction="#onCancel" styleClass="btn-danger"/>
</VBox>
