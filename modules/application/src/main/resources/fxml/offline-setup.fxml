<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.conava.chess.application.controllers.OfflineSetupController"
      styleClass="overlay-card" spacing="0" minWidth="420">
    <padding><Insets top="32" right="40" bottom="32" left="40"/></padding>

    <Label text="%dialog.offline.title" styleClass="dialog-title"/>

    <!-- Player name fields in a 2-column grid for aligned labels and inputs -->
    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="35"/>
            <ColumnConstraints percentWidth="65" hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="%dialog.offline.white" GridPane.rowIndex="0" GridPane.columnIndex="0"
               GridPane.valignment="CENTER"/>
        <TextField fx:id="whiteField" promptText="%dialog.offline.white"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%dialog.offline.black" GridPane.rowIndex="1" GridPane.columnIndex="0"
               GridPane.valignment="CENTER"/>
        <TextField fx:id="blackField" promptText="%dialog.offline.black"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator style="-fx-padding: 4 0 0 0;"/>

    <Label text="%dialog.offline.ruleset" styleClass="section-heading"/>
    <ComboBox fx:id="rulesetBox" maxWidth="Infinity"/>

    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
        <Button text="%dialog.offline.cancel" onAction="#onCancel" styleClass="btn-ghost"/>
        <Button text="%dialog.offline.start"  onAction="#onStart"  styleClass="btn-primary"/>
    </HBox>
</VBox>
