<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="io.github.conava.chess.application.controllers.OfflineSetupController"
           style="-fx-background-color: transparent;">

    <!-- Frosted-glass form panel, right-aligned over the persistent background -->
    <VBox fx:id="setupPanel" styleClass="cinematic-form-panel"
          StackPane.alignment="CENTER_RIGHT">
        <StackPane.margin><Insets top="20" right="40" bottom="20" left="0"/></StackPane.margin>

        <!-- Title -->
        <Label text="%dialog.offline.title" styleClass="dialog-title"/>

        <!-- Player names -->
        <Label text="%auth.players" styleClass="section-heading">
            <VBox.margin><Insets top="16"/></VBox.margin>
        </Label>
        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="38"/>
                <ColumnConstraints percentWidth="62" hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="%dialog.offline.white" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   GridPane.valignment="CENTER"/>
            <TextField fx:id="whiteField" promptText="%dialog.offline.white"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="%dialog.offline.black" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   GridPane.valignment="CENTER"/>
            <TextField fx:id="blackField" promptText="%dialog.offline.black"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Ruleset selection -->
        <Label text="%dialog.offline.ruleset" styleClass="section-heading">
            <VBox.margin><Insets top="20"/></VBox.margin>
        </Label>
        <ComboBox fx:id="rulesetBox" maxWidth="Infinity"/>

        <!-- Actions -->
        <HBox spacing="12" alignment="CENTER">
            <VBox.margin><Insets top="28"/></VBox.margin>
            <Button text="%dialog.offline.start" onAction="#onStart" styleClass="btn-primary"/>
            <Button text="%dialog.offline.cancel" onAction="#onCancel" styleClass="btn-ghost"/>
        </HBox>
    </VBox>
</StackPane>
