<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:id="rootPane"
           fx:controller="io.github.conava.chess.application.controllers.MainMenuController">

    <!-- Navigation panel — left-aligned, vertically centered.
         Animated layers (title, tagline) are added programmatically in the controller
         and inserted before this node in the StackPane children list. -->
    <VBox fx:id="navPanel" styleClass="cinematic-nav-panel"
          alignment="CENTER"
          StackPane.alignment="CENTER_RIGHT">

        <Button fx:id="localGameBtn" text="%menu.local" onAction="#onLocalGame"
                styleClass="cinematic-nav-button" maxWidth="Infinity">
            <graphic><Label text="&#x2658;" mouseTransparent="true"/></graphic>
        </Button>

        <Button fx:id="onlineGameBtn" text="%menu.online" onAction="#onOnlineGame"
                styleClass="cinematic-nav-button" maxWidth="Infinity">
            <graphic><Label text="&#x2656;" mouseTransparent="true"/></graphic>
        </Button>

        <Button fx:id="settingsBtn" text="%menu.settings" onAction="#onSettings"
                styleClass="cinematic-nav-button" maxWidth="Infinity">
            <graphic><Label text="&#x2657;" mouseTransparent="true"/></graphic>
        </Button>

        <Button fx:id="exitBtn" text="%menu.exit" onAction="#onExit"
                styleClass="cinematic-nav-button,cinematic-nav-button-exit" maxWidth="Infinity">
            <graphic><Label text="&#x00D7;" mouseTransparent="true"/></graphic>
        </Button>
    </VBox>

    <!-- Panel container — hosts sub-screen panels (offline setup, online setup, settings,
         login, register, waiting-for-match) as in-place panels without scene swap.
         Width is bound responsively via ResponsiveMenuLayout in the controller's initialize(). -->
    <StackPane fx:id="panelContainer" styleClass="cinematic-panel-container"
               StackPane.alignment="CENTER_RIGHT"
               pickOnBounds="false"/>

</StackPane>
