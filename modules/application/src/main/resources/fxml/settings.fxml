<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      spacing="0" minWidth="500" maxWidth="700" alignment="CENTER">
    <fx:define>
        <ToggleGroup fx:id="themeGroup"/>
        <ToggleGroup fx:id="boardGroup"/>
        <ToggleGroup fx:id="langGroup"/>
    </fx:define>
    <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

    <Label text="%settings.title" styleClass="dialog-title"/>

    <!-- Appearance -->
    <Label text="%settings.appearance" styleClass="section-heading"/>
    <VBox styleClass="card" spacing="16">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <!-- Theme picker — 2×2 swatch grid -->
        <Label text="%settings.theme" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
        <GridPane hgap="12" vgap="12">
            <!-- Dark: Midnight -->
            <ToggleButton fx:id="midnightSwatch"
                          text="Midnight"
                          toggleGroup="$themeGroup"
                          styleClass="theme-swatch"
                          style="-fx-background-color: linear-gradient(to right, #080812 60%, #8b5cf6 40%); -fx-text-fill: #ededf8;"
                          GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <!-- Dark: Ember -->
            <ToggleButton fx:id="emberSwatch"
                          text="Ember"
                          toggleGroup="$themeGroup"
                          styleClass="theme-swatch"
                          style="-fx-background-color: linear-gradient(to right, #111111 60%, #f59e0b 40%); -fx-text-fill: #f2f0eb;"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <!-- Light: Manuscript -->
            <ToggleButton fx:id="manuscriptSwatch"
                          text="Manuscript"
                          toggleGroup="$themeGroup"
                          styleClass="theme-swatch"
                          style="-fx-background-color: linear-gradient(to right, #f7f2e9 60%, #9a3412 40%); -fx-text-fill: #1c1108;"
                          GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <!-- Light: Fjord -->
            <ToggleButton fx:id="fjordSwatch"
                          text="Fjord"
                          toggleGroup="$themeGroup"
                          styleClass="theme-swatch"
                          style="-fx-background-color: linear-gradient(to right, #eef3f8 60%, #0284c7 40%); -fx-text-fill: #0a1929;"
                          GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>

        <!-- Board colour picker -->
        <Label text="%settings.board" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 0 0 0;"/>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <ToggleButton fx:id="classicSwatch" text="Classic" styleClass="theme-swatch"
                          toggleGroup="$boardGroup"
                          style="-fx-background-color: linear-gradient(to right, #f0d9b5 50%, #b58863 50%); -fx-text-fill: #2c1e10;"
                          minWidth="90" minHeight="44"/>
            <ToggleButton fx:id="oceanSwatch"   text="Ocean"   styleClass="theme-swatch"
                          toggleGroup="$boardGroup"
                          style="-fx-background-color: linear-gradient(to right, #dee3e6 50%, #4a90a4 50%); -fx-text-fill: #0a2030;"
                          minWidth="90" minHeight="44"/>
            <ToggleButton fx:id="walnutSwatch"  text="Walnut"  styleClass="theme-swatch"
                          toggleGroup="$boardGroup"
                          style="-fx-background-color: linear-gradient(to right, #d4b896 50%, #7a4f2c 50%); -fx-text-fill: #1a0c04;"
                          minWidth="90" minHeight="44"/>
        </HBox>
    </VBox>

    <!-- Language -->
    <Label text="%settings.language" styleClass="section-heading"/>
    <VBox styleClass="card" spacing="14">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <ToggleButton fx:id="enToggle" text="English" toggleGroup="$langGroup"/>
            <ToggleButton fx:id="deToggle" text="Deutsch" toggleGroup="$langGroup"/>
        </HBox>
    </VBox>

    <!-- Player names -->
    <Label text="%settings.players" styleClass="section-heading"/>
    <VBox styleClass="card" spacing="12">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        <TextField fx:id="whiteNameField" promptText="%settings.player.white"/>
        <TextField fx:id="blackNameField" promptText="%settings.player.black"/>
    </VBox>

    <!-- Actions -->
    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 24 0 0 0;">
        <Button text="%settings.cancel" onAction="#onCancel" styleClass="btn-ghost"/>
        <Button text="%settings.save"   onAction="#onSave"   styleClass="btn-primary"/>
    </HBox>
</VBox>
