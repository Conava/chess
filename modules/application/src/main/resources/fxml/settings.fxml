<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="io.github.conava.chess.application.controllers.SettingsController"
           style="-fx-background-color: transparent;">

    <fx:define>
        <ToggleGroup fx:id="themeGroup"/>
        <ToggleGroup fx:id="langGroup"/>
    </fx:define>

    <!-- Frosted-glass form panel, right-aligned over the persistent background -->
    <VBox fx:id="settingsPanel" styleClass="cinematic-form-panel"
          StackPane.alignment="CENTER_RIGHT">
        <StackPane.margin><Insets top="20" right="40" bottom="20" left="0"/></StackPane.margin>

        <ScrollPane fitToWidth="true" styleClass="edge-to-edge" hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="0">
                <padding><Insets top="32" right="28" bottom="32" left="28"/></padding>

                <Label text="%settings.title" styleClass="dialog-title"/>

                <!-- Appearance -->
                <Label text="%settings.appearance" styleClass="section-heading"/>
                <VBox styleClass="card" spacing="16">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <Label text="%settings.theme"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <FlowPane hgap="12" vgap="12">
                        <ToggleButton fx:id="midnightSwatch" text="Midnight"
                                      toggleGroup="$themeGroup" styleClass="theme-swatch"
                                      style="-fx-background-color: linear-gradient(to right, #080812 60%, #8b5cf6 40%); -fx-text-fill: #ededf8;"/>
                        <ToggleButton fx:id="emberSwatch" text="Ember"
                                      toggleGroup="$themeGroup" styleClass="theme-swatch"
                                      style="-fx-background-color: linear-gradient(to right, #111111 60%, #f59e0b 40%); -fx-text-fill: #f2f0eb;"/>
                        <ToggleButton fx:id="abyssSwatch" text="Abyss"
                                      toggleGroup="$themeGroup" styleClass="theme-swatch"
                                      style="-fx-background-color: linear-gradient(to right, #060f1e 60%, #06b6d4 40%); -fx-text-fill: #e0f2fe;"/>
                        <ToggleButton fx:id="manuscriptSwatch" text="Manuscript"
                                      toggleGroup="$themeGroup" styleClass="theme-swatch"
                                      style="-fx-background-color: linear-gradient(to right, #f7f2e9 60%, #9a3412 40%); -fx-text-fill: #1c1108;"/>
                        <ToggleButton fx:id="fjordSwatch" text="Fjord"
                                      toggleGroup="$themeGroup" styleClass="theme-swatch"
                                      style="-fx-background-color: linear-gradient(to right, #eef3f8 60%, #0284c7 40%); -fx-text-fill: #0a1929;"/>
                        <ToggleButton fx:id="sakuraSwatch" text="Sakura"
                                      toggleGroup="$themeGroup" styleClass="theme-swatch"
                                      style="-fx-background-color: linear-gradient(to right, #fdf6f8 60%, #be185d 40%); -fx-text-fill: #1c0714;"/>
                    </FlowPane>

                </VBox>

                <!-- Language -->
                <Label text="%settings.language" styleClass="section-heading"/>
                <VBox styleClass="card" spacing="14">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <ToggleButton fx:id="enToggle" text="English" toggleGroup="$langGroup"/>
                        <ToggleButton fx:id="deToggle" text="Deutsch" toggleGroup="$langGroup"/>
                    </HBox>
                </VBox>

                <!-- Online -->
                <Label text="%settings.online" styleClass="section-heading"/>
                <VBox styleClass="card" spacing="12">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <Label text="%settings.online.server"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <TextField fx:id="serverIpField" promptText="%settings.online.ip" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="serverPortField" promptText="%settings.online.port" prefWidth="90"/>
                    </HBox>

                    <Label text="%settings.online.account"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;">
                        <VBox.margin><Insets top="8"/></VBox.margin>
                    </Label>
                    <Label fx:id="loginStatusLabel"/>
                    <Button fx:id="logoutBtn" text="%settings.online.logout" onAction="#onLogout"
                            styleClass="btn-ghost"/>
                </VBox>

                <!-- Actions -->
                <HBox spacing="12" alignment="CENTER">
                    <VBox.margin><Insets top="16"/></VBox.margin>
                    <Button fx:id="saveBtn" text="%settings.save" onAction="#onSave" styleClass="btn-primary"/>
                    <Button fx:id="cancelBtn" text="%settings.cancel" onAction="#onCancel" styleClass="btn-ghost"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>

</StackPane>
