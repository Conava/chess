<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.conava.chess.application.controllers.SettingsController">
    <fx:define>
        <ToggleGroup fx:id="themeGroup"/>
        <ToggleGroup fx:id="langGroup"/>
    </fx:define>

    <!-- ── Left: brand panel ─────────────────────────────────────────────── -->
    <StackPane styleClass="menu-brand-panel" minWidth="260" maxWidth="300">
        <Label text="♞" mouseTransparent="true" StackPane.alignment="CENTER"
               style="-fx-font-size: 200px; -fx-opacity: 0.08; -fx-rotate: 8;"/>
        <VBox alignment="BOTTOM_CENTER" spacing="8" StackPane.alignment="CENTER">
            <padding><Insets top="60" right="32" bottom="80" left="32"/></padding>
            <Label text="%menu.title"
                   style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
            <Label text="%settings.title" styleClass="auth-screen-subtitle"/>
        </VBox>
    </StackPane>

    <!-- ── Right: settings panel ─────────────────────────────────────────── -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="0">
            <padding><Insets top="52" right="64" bottom="52" left="64"/></padding>

            <Label text="%settings.title" styleClass="dialog-title"/>

            <!-- Appearance -->
            <Label text="%settings.appearance" styleClass="section-heading"/>
            <VBox styleClass="card" spacing="16">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <Label text="%settings.theme"
                       style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                <GridPane hgap="12" vgap="12">
                    <ToggleButton fx:id="midnightSwatch" text="Midnight"
                                  toggleGroup="$themeGroup" styleClass="theme-swatch"
                                  style="-fx-background-color: linear-gradient(to right, #080812 60%, #8b5cf6 40%); -fx-text-fill: #ededf8;"
                                  GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ToggleButton fx:id="emberSwatch" text="Ember"
                                  toggleGroup="$themeGroup" styleClass="theme-swatch"
                                  style="-fx-background-color: linear-gradient(to right, #111111 60%, #f59e0b 40%); -fx-text-fill: #f2f0eb;"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <ToggleButton fx:id="manuscriptSwatch" text="Manuscript"
                                  toggleGroup="$themeGroup" styleClass="theme-swatch"
                                  style="-fx-background-color: linear-gradient(to right, #f7f2e9 60%, #9a3412 40%); -fx-text-fill: #1c1108;"
                                  GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ToggleButton fx:id="fjordSwatch" text="Fjord"
                                  toggleGroup="$themeGroup" styleClass="theme-swatch"
                                  style="-fx-background-color: linear-gradient(to right, #eef3f8 60%, #0284c7 40%); -fx-text-fill: #0a1929;"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <ToggleButton fx:id="abyssSwatch" text="Abyss"
                                  toggleGroup="$themeGroup" styleClass="theme-swatch"
                                  style="-fx-background-color: linear-gradient(to right, #060f1e 60%, #06b6d4 40%); -fx-text-fill: #e0f2fe;"
                                  GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <ToggleButton fx:id="sakuraSwatch" text="Sakura"
                                  toggleGroup="$themeGroup" styleClass="theme-swatch"
                                  style="-fx-background-color: linear-gradient(to right, #fdf6f8 60%, #be185d 40%); -fx-text-fill: #1c0714;"
                                  GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                </GridPane>

            </VBox>

            <!-- Language -->
            <Label text="%settings.language" styleClass="section-heading"/>
            <VBox styleClass="card" spacing="14">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ToggleButton fx:id="enToggle" text="English" toggleGroup="$langGroup"/>
                    <ToggleButton fx:id="deToggle" text="Deutsch" toggleGroup="$langGroup"/>
                </HBox>
            </VBox>

            <!-- Player names -->
            <Label text="%settings.players" styleClass="section-heading"/>
            <VBox styleClass="card" spacing="12">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <TextField fx:id="whiteNameField" promptText="%settings.player.white"/>
                <TextField fx:id="blackNameField" promptText="%settings.player.black"/>
            </VBox>

            <!-- Actions -->
            <VBox spacing="10" style="-fx-padding: 28 0 0 0;">
                <Button text="%settings.save"   onAction="#onSave"
                        styleClass="btn-primary" maxWidth="Infinity"/>
                <Button text="%settings.cancel" onAction="#onCancel"
                        styleClass="btn-ghost"   maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </ScrollPane>

</HBox>
