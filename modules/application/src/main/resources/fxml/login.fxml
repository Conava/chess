<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    Login panel — cinematic frosted-glass form, right-aligned over the
    persistent cinematic background hosted in MainMenuController.

    Converted from the old HBox (brand-panel + form) layout to a single
    VBox matching the offline-setup.fxml / online-setup.fxml pattern.
    All fx:id attributes are preserved for LoginController binding.
-->
<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="io.github.conava.chess.application.controllers.LoginController"
           style="-fx-background-color: transparent;">

    <!-- Frosted-glass form panel, right-aligned over the persistent background -->
    <VBox fx:id="loginPanel" styleClass="cinematic-form-panel"
          StackPane.alignment="CENTER_RIGHT">
        <StackPane.margin><Insets top="20" right="40" bottom="20" left="0"/></StackPane.margin>

        <!-- Title -->
        <Label text="%login.title" styleClass="dialog-title"/>

        <!-- Server group -->
        <Label text="%auth.server" styleClass="section-heading">
            <VBox.margin><Insets top="16"/></VBox.margin>
        </Label>
        <HBox spacing="10">
            <TextField fx:id="ipField" promptText="%dialog.online.ip" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="portField" promptText="%dialog.online.port" prefWidth="90"/>
        </HBox>

        <!-- Account group -->
        <Label text="%auth.account" styleClass="section-heading">
            <VBox.margin><Insets top="16"/></VBox.margin>
        </Label>
        <TextField fx:id="usernameField" promptText="%login.username" maxWidth="Infinity"/>
        <PasswordField fx:id="passwordField" promptText="%login.password" maxWidth="Infinity"/>

        <!-- Error message -->
        <Label fx:id="errorLabel" styleClass="form-error" maxWidth="Infinity"
               visible="false" managed="false">
            <VBox.margin><Insets top="8"/></VBox.margin>
        </Label>

        <!-- Action buttons -->
        <VBox spacing="10">
            <VBox.margin><Insets top="28"/></VBox.margin>
            <Button fx:id="loginButton" text="%login.title" onAction="#onLogin"
                    styleClass="btn-primary" maxWidth="Infinity"/>
            <Button text="%dialog.offline.cancel" onAction="#onCancel"
                    styleClass="btn-ghost" maxWidth="Infinity"/>
        </VBox>

        <!-- Switch-screen link -->
        <Hyperlink fx:id="registerLink" text="%login.register" onAction="#onRegister"
                   maxWidth="Infinity" alignment="CENTER">
            <VBox.margin><Insets top="14"/></VBox.margin>
        </Hyperlink>
    </VBox>

</StackPane>
