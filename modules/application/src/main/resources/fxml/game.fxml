<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.conava.chess.application.controllers.GameController"
            styleClass="root">

    <!-- Left: black player card + chat panel (online only) — width bound to board size from GameController -->
    <left>
        <VBox fx:id="leftPanel" spacing="12" BorderPane.alignment="CENTER">
            <padding><Insets top="20" right="12" bottom="20" left="16"/></padding>
            <VBox styleClass="card" alignment="TOP_CENTER" spacing="8">
                <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
                <Label fx:id="blackName"   styleClass="player-name" text="Black"/>
                <Label fx:id="blackActive" styleClass="player-active-indicator"/>
            </VBox>
            <Label fx:id="gameLabelDisplay" styleClass="section-heading"
                   wrapText="true" visible="false" managed="false"/>
            <!-- Chat panel — only shown for online games -->
            <VBox fx:id="chatPanel" spacing="6" visible="false" managed="false" VBox.vgrow="ALWAYS">
                <Label text="%game.chat" styleClass="section-heading"/>
                <ListView fx:id="chatList" styleClass="move-list-view" VBox.vgrow="ALWAYS"/>
                <HBox spacing="6">
                    <TextField fx:id="chatInput" promptText="%game.chat.placeholder"
                               HBox.hgrow="ALWAYS"/>
                    <Button text="%game.chat.send" onAction="#onSendChat"/>
                </HBox>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <!-- Save & Exit — only shown for online games -->
            <Button fx:id="saveExitBtn" text="%game.save.request" onAction="#onSaveAndExit"
                    styleClass="btn-secondary" maxWidth="Infinity"
                    visible="false" managed="false"/>
        </VBox>
    </left>

    <!-- Center: board — rank/file labels are drawn inside the corner squares themselves -->
    <center>
        <StackPane fx:id="boardContainer" minWidth="320" minHeight="320"
                   BorderPane.alignment="CENTER"/>
    </center>

    <!-- Right: white player card + move list + leave button — width bound from controller -->
    <right>
        <VBox fx:id="rightPanel" spacing="12" BorderPane.alignment="CENTER">
            <padding><Insets top="20" right="16" bottom="20" left="12"/></padding>
            <VBox styleClass="card" alignment="TOP_CENTER" spacing="8">
                <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
                <Label fx:id="whiteName"   styleClass="player-name" text="White"/>
                <Label fx:id="whiteActive" styleClass="player-active-indicator"/>
            </VBox>
            <Label text="%game.moves" styleClass="section-heading"/>
            <ListView fx:id="moveList" styleClass="move-list-view" VBox.vgrow="ALWAYS"/>
            <Button text="%game.leave" onAction="#onLeaveGame"
                    styleClass="btn-danger" maxWidth="Infinity"/>
        </VBox>
    </right>
</BorderPane>
